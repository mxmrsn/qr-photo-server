# Copy to .env and edit. Every value here is optional.

# ---- The event -------------------------------------------------------------
COUPLE_NAMES=Max & Rachel
EVENT_DATE=
EVENT_HASHTAG=
WELCOME_MESSAGE=Help us see today through your eyes. Every photo and video you add lands straight in our album.
THANKS_MESSAGE=Thank you — we can't wait to see these.

# ---- Where this instance lives ---------------------------------------------
# QR codes are generated from this. Point it at your domain, not an IP, so
# you can move the backend later without reprinting anything.
BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# Only turn this on behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# ---- Look and feel ---------------------------------------------------------
ACCENT=#8a6f4e
ACCENT_SOFT=#efe7db
# Hue for the logo inside the QR code. Only the hue is used — luminance is
# pinned to values verified to scan, so this cannot break the code.
# Leave blank for neutral grey.
QR_ACCENT=#9b8aa6
INK=#2c2825
PAPER=#fbf8f3

# ---- Storage and limits ----------------------------------------------------
DATA_DIR=
MAX_FILE_MB=512
MAX_FILES_PER_BATCH=40
UPLOAD_RATE_PER_HOUR=400

# ---- Behaviour -------------------------------------------------------------
# off       — everything appears everywhere immediately (recommended)
# slideshow — gallery is live, but the projector needs your approval
# all       — nothing is public until approved
MODERATION=off

ALLOW_GUEST_GALLERY=true
ALLOW_GUEST_DOWNLOAD=false
SLIDESHOW_SECONDS=7

# Videos play with their audio track removed, so their speech is transcribed
# locally and shown as subtitles instead. Needs faster-whisper installed.
TRANSCRIBE_VIDEO=true
WHISPER_MODEL=base          # tiny | base | small | medium
WHISPER_LANGUAGE=           # blank = auto-detect

# Lets the upload page search your seating chart so guests pick their name and
# the table comes with it. Off hides the roster from anyone holding the URL.
GUEST_LIST_PUBLIC=true
SLIDESHOW_MAX_VIDEO_SECONDS=25

# Flip to true after the wedding to change the copy on the upload page.
POST_EVENT=false

# Leave blank and one is generated into data/admin_password.txt on first run.
ADMIN_PASSWORD=
